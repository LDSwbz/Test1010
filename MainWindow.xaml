<Window x:Class="ScanningPowerCylinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ScanningPowerCylinder.Models"
        xmlns:local="clr-namespace:ScanningPowerCylinder"
        Title="注入机扫描硬件控制" Height="760" Width="1280"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextMainBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:RangeToOneIndexConverter x:Key="RangeToOneIndexConverter"/>
        <!-- 法桶卡片数据模板 -->
        <DataTemplate x:Key="CupCardTemplate" DataType="{x:Type models:CupData}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,22,14,14" Margin="4">
                <StackPanel>
                    <!-- 通道标题 -->
                    <TextBlock Text="{Binding Index, StringFormat=法桶通道 #{0}}" FontWeight="SemiBold"
                               FontSize="14" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                    <!-- 当前电流 -->
                    <Border Background="#FF1B1D2A" CornerRadius="4" Padding="0,8" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Current, StringFormat={}{0:F3} nA}"
                                   HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <!-- 量程 / 模式 / 时间 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="量程:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <ComboBox x:Name="comboRange" Grid.Row="0" Grid.Column="1" Margin="0,2"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CupRanges}"
                                  SelectedIndex="{Binding Range, Converter={StaticResource RangeToOneIndexConverter}, Mode=TwoWay}"
                                  SelectionChanged="CupRange_Changed" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模式:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <ComboBox x:Name="comboMode" Grid.Row="1" Grid.Column="1" Margin="0,2"
                                  SelectedIndex="{Binding Mode, Mode=TwoWay}"
                                  SelectionChanged="CupMode_Changed" VerticalAlignment="Center">
                            <ComboBoxItem Content="0: 固定-扫描"/>
                            <ComboBoxItem Content="1: 自动-扫描"/>
                            <ComboBoxItem Content="2: 单次-固定"/>
                            <ComboBoxItem Content="3: 单次-自动"/>
                            <ComboBoxItem Content="4: 多次-固定"/>
                            <ComboBoxItem Content="5: 多次-自动"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="时间(ms):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox x:Name="spinCollectTime" Grid.Row="2" Grid.Column="1" Margin="0,2"
                                 Text="{Binding CollectTime, Mode=TwoWay}"
                                 LostFocus="CupCollectTime_LostFocus" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 数据指标 -->
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="峰值:" Margin="0,0,8,2" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PeakCurrent, StringFormat={}{0:F3} nA}" FontWeight="SemiBold" Foreground="{DynamicResource OrangeBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="积分:" Margin="0,0,8,2" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Integral, StringFormat={}{0} nC}" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="理论积分:" Margin="0,0,8,2" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TheoryIntegral}" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="积分电压:" Margin="0,0,8,2" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IntegralVoltage}" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="电流源输入:" Margin="0,0,8,2" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SourceInput}" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="误差(‰):" Margin="0,0,8,2" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Error}" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}"/>
                    </Grid>

                    <!-- 状态与操作 -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,6"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnStartCollect" Content="开始" Width="50" Height="24" Padding="0" Margin="0,0,6,0" Click="CupStartCollect_Click"/>
                            <CheckBox x:Name="chkRecord" Content="记录" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="btnShowStats" Content="统计..." Width="50" Height="24" Padding="0" Click="CupShowStats_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== 顶部连接栏 ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="服务器 IP:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtIp" Width="120" Text="192.168.1.141"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtPort" Width="60" Text="502"/>
                </StackPanel>
                <Button x:Name="btnConnect" Content="连接" Style="{StaticResource AccentButton}" Click="BtnConnect_Click" Margin="0,0,12,0"/>
                <Border x:Name="statusPill" Style="{StaticResource StatusPill}" Margin="0,0,12,0">
                    <TextBlock x:Name="lblStatus" Text="未连接" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="系统状态:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border x:Name="systemErrPill" Style="{StaticResource StatusPill}">
                        <TextBlock x:Name="lblSystemErr" Text="正常" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="ADC:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboADC" Width="140" SelectionChanged="ComboADC_Changed">
                        <ComboBoxItem Content="ADS127 (默认)" IsSelected="True"/>
                        <ComboBoxItem Content="CS1237"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="读取间隔:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboReadInterval" Width="90" SelectionChanged="ComboReadInterval_Changed">
                        <ComboBoxItem Content="100 ms" IsSelected="True"/>
                        <ComboBoxItem Content="200 ms"/>
                        <ComboBoxItem Content="300 ms"/>
                        <ComboBoxItem Content="400 ms"/>
                        <ComboBoxItem Content="500 ms"/>
                        <ComboBoxItem Content="600 ms"/>
                        <ComboBoxItem Content="700 ms"/>
                        <ComboBoxItem Content="800 ms"/>
                        <ComboBoxItem Content="900 ms"/>
                        <ComboBoxItem Content="1000 ms"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===================== TabControl ===================== -->
        <TabControl Padding="0" Margin="10">
            <!-- Tab 1: 法桶监测 -->
            <TabItem Header="法桶监测 (Cups)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl x:Name="cupsContainer" ItemTemplate="{StaticResource CupCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 扫描电源 -->
            <TabItem Header="扫描电源 (Power)" RenderTransformOrigin="3.746,6.341">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- 基础控制 & 状态 -->
                        <GroupBox Header="基础控制 &amp; 状态" Margin="0,0,0,10">
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="频率法桶:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBlock x:Name="lblFreqCup" Grid.Row="0" Grid.Column="1" Text="—" VerticalAlignment="Center" Margin="0,0,10,8" MinWidth="60"/>
                                <ComboBox x:Name="spinFreqCup" Grid.Row="0" Grid.Column="2" Width="60" VerticalAlignment="Center" Margin="0,0,10,8">
                                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                                </ComboBox>
                                <Button Grid.Row="0" Grid.Column="3" Content="写入" Width="60" Margin="0,0,0,8" Click="BtnWriteFreqCup_Click"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="电源控制:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <ComboBox x:Name="comboControl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8" SelectionChanged="ComboControl_Changed">
                                    <ComboBoxItem Content="0: 停止" IsSelected="True"/>
                                    <ComboBoxItem Content="1: 手动"/>
                                    <ComboBoxItem Content="2: 自动"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="工作状态:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBlock x:Name="lblPowerStatus" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="未知" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="操作:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Content="执行故障恢复" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" Click="BtnRecover_Click"/>
                            </Grid>
                        </GroupBox>

                        <!-- 全局输出参数 -->
                        <GroupBox Header="全局输出参数" Margin="0,0,0,10">
                          <StackPanel>
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="" Margin="0,0,10,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="当前读数" Margin="0,0,10,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="设定值" Margin="0,0,10,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="输出频率:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBlock x:Name="lblOutFreq" Grid.Row="1" Grid.Column="1" Text="0.000 Hz" VerticalAlignment="Center" MinWidth="80" Margin="0,0,10,8"/>
                                <TextBox x:Name="spinOutFreq" Grid.Row="1" Grid.Column="2" Width="80" Text="0" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="写入" Width="60" Margin="0,0,0,8" Click="BtnWriteOutFreq_Click"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="相位:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBlock x:Name="lblPhase" Grid.Column="1" Text="180 °" VerticalAlignment="Center" MinWidth="80" Margin="0,0,10,8"/>
                                <TextBox x:Name="spinPhase" Grid.Column="2" Width="80" Text="180" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <Button Grid.Column="3" Content="写入" Width="60" Margin="0,0,0,8" Click="BtnWritePhase_Click"/>
                            </Grid>
                          </StackPanel>
                        </GroupBox>

                        <!-- 双通道波形参数 -->
                        <UniformGrid Columns="2" Rows="1">
                            <GroupBox Header="通道1" Margin="0,0,8,0">
                                <StackPanel Margin="0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="波形代码:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="lblWave1" Text="0" VerticalAlignment="Center" MinWidth="60"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="峰值:" VerticalAlignment="Center" Margin="0,0,10,0" Width="60"/>
                                        <TextBlock x:Name="lblPeak1" Text="0.000 V" VerticalAlignment="Center" MinWidth="80"/>
                                        <TextBox x:Name="spinPeak1" Width="70" Text="0" Margin="10,0,0,0"/>
                                        <Button Content="写入" Width="60" Margin="8,0,0,0" Click="BtnWritePeak1_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="谷值:" VerticalAlignment="Center" Margin="0,0,10,0" Width="60"/>
                                        <TextBlock x:Name="lblValley1" Text="0.000 V" VerticalAlignment="Center" MinWidth="80"/>
                                        <TextBox x:Name="spinValley1" Width="70" Text="0" Margin="10,0,0,0"/>
                                        <Button Content="写入" Width="60" Margin="8,0,0,0" Click="BtnWriteValley1_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="通道2" Margin="8,0,0,0">
                                <StackPanel Margin="0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="波形代码:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="lblWave2" Text="0" VerticalAlignment="Center" MinWidth="60"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="峰值:" VerticalAlignment="Center" Margin="0,0,10,0" Width="60"/>
                                        <TextBlock x:Name="lblPeak2" Text="0.000 V" VerticalAlignment="Center" MinWidth="80"/>
                                        <TextBox x:Name="spinPeak2" Width="70" Text="0" Margin="10,0,0,0"/>
                                        <Button Content="写入" Width="60" Margin="8,0,0,0" Click="BtnWritePeak2_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="谷值:" VerticalAlignment="Center" Margin="0,0,10,0" Width="60"/>
                                        <TextBlock x:Name="lblValley2" Text="0.000 V" VerticalAlignment="Center" MinWidth="80"/>
                                        <TextBox x:Name="spinValley2" Width="70" Text="0" Margin="10,0,0,0"/>
                                        <Button Content="写入" Width="60" Margin="8,0,0,0" Click="BtnWriteValley2_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 电流源 C2000A -->
            <TabItem Header="电流源 (C2000A)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <GroupBox Header="串口配置" Margin="0,0,0,10">
                          <StackPanel>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                                <ComboBox x:Name="comboC2000APort" Grid.Column="1" Width="100" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                <TextBlock Grid.Column="2" Text="波特率:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                                <ComboBox x:Name="comboC2000ABaud" Grid.Column="3" Width="80" VerticalAlignment="Center" Margin="0,0,12,8">
                                    <ComboBoxItem Content="9600" IsSelected="True"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="115200"/>
                                </ComboBox>
                                <Button x:Name="btnC2000AConnect" Grid.Column="4" Content="连接" Width="70" Margin="0,0,8,8" Click="BtnC2000AConnect_Click"/>
                                <Button x:Name="btnC2000ARefresh" Grid.Column="5" Content="刷新端口" Width="80" Margin="0,0,0,8" Click="BtnC2000ARefresh_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="连接状态: " VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblC2000AConnStatus" Text="未连接" VerticalAlignment="Center"/>
                            </StackPanel>
                          </StackPanel>
                        </GroupBox>

                        <GroupBox Header="写电流" Margin="0,0,0,10">
                            <StackPanel Margin="0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="量程档位:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="comboC2000ARange" Width="100" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <ComboBoxItem Content="2uA档" IsSelected="True"/>
                                        <ComboBoxItem Content="20uA档"/>
                                        <ComboBoxItem Content="200uA档"/>
                                        <ComboBoxItem Content="2mA档"/>
                                    </ComboBox>
                                    <TextBlock Text="电流值(A):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="spinC2000ACurrent" Width="100" Text="0.00001" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="写入" Width="70" Click="BtnC2000AWriteCurrent_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="lblC2000ALastCurrent" Text="上次写入: ---" VerticalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="读电压" Margin="0,0,0,10">
                            <StackPanel Margin="0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="电压(mV):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="lblC2000AVoltage" Text="---" VerticalAlignment="Center" MinWidth="80"/>
                                    <Button Content="读取" Width="70" Margin="20,0,0,0" Click="BtnC2000AReadVoltage_Click"/>
                                    <TextBlock Text="轮询:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                                    <ComboBox x:Name="comboC2000APoll" Width="100" SelectionChanged="ComboC2000APoll_Changed">
                                        <ComboBoxItem Content="关闭" IsSelected="True"/>
                                        <ComboBoxItem Content="500 ms"/>
                                        <ComboBoxItem Content="1000 ms"/>
                                        <ComboBoxItem Content="2000 ms"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: 自动校准 -->
            <TabItem Header="自动校准">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <GroupBox Header="自动校准参数" Margin="0,0,0,10">
                            <StackPanel Margin="0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="校准法桶:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="comboAutoCalCup" Width="120" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <ComboBoxItem Content="法桶 1" IsSelected="True"/>
                                        <ComboBoxItem Content="法桶 2"/>
                                        <ComboBoxItem Content="法桶 3"/>
                                        <ComboBoxItem Content="法桶 4"/>
                                        <ComboBoxItem Content="法桶 5"/>
                                        <ComboBoxItem Content="法桶 6"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="输出 CSV:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtAutoCalOutput" Width="400" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="浏览..." Width="70" Click="BtnBrowseAutoCalOutput_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnAutoCalStart" Content="开始" Width="80" Margin="0,0,10,0" Click="BtnAutoCalStart_Click"/>
                                    <Button x:Name="btnAutoCalStop" Content="停止" Width="80" Margin="0,0,10,0" Click="BtnAutoCalStop_Click"/>
                                    <Button x:Name="btnAutoCalCalcCoeff" Content="从 CSV 计算系数" Width="130" Click="BtnAutoCalCalcCoeff_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="状态: " VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblAutoCalStatus" Text="就绪" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="进度: " VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblAutoCalProgress" Text="" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="自动校准记录">
                            <DataGrid x:Name="gridAutoCalRecords" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Height="220" Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="100"/>
                                    <DataGridTextColumn Header="法桶" Binding="{Binding CupIndex}" Width="50"/>
                                    <DataGridTextColumn Header="法桶档位" Binding="{Binding CupRangeName}" Width="80"/>
                                    <DataGridTextColumn Header="设定输入(uA)" Binding="{Binding SetCurrentUA, StringFormat={}{0:F3}}" Width="100"/>
                                    <DataGridTextColumn Header="电流源档位" Binding="{Binding SourceRangeName}" Width="100"/>
                                    <DataGridTextColumn Header="实测平均(uA)" Binding="{Binding MeasuredAvgUA, StringFormat={}{0:F3}}" Width="100"/>
                                    <DataGridTextColumn Header="峰值(nA)" Binding="{Binding PeakNA, StringFormat={}{0:F1}}" Width="80"/>
                                    <DataGridTextColumn Header="积分(nC)" Binding="{Binding IntegralNC}" Width="80"/>
                                    <DataGridTextColumn Header="样本数" Binding="{Binding SampleCount}" Width="60"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: 校准参数 -->
            <TabItem Header="校准参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <GroupBox Header="校准系数文件" Margin="0,0,0,10">
                            <StackPanel Margin="0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="CSV 文件:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtCalibCoeffFile" Width="400" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="btnCalibBrowse" Content="浏览..." Width="70" Click="BtnCalibBrowse_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnCalibLoad" Content="加载 CSV" Width="90" Margin="0,0,10,0" Click="BtnCalibLoad_Click"/>
                                    <Button x:Name="btnCalibRead" Content="从设备读取" Width="100" Margin="0,0,10,0" Click="BtnCalibRead_Click"/>
                                    <Button x:Name="btnCalibFromAutoCsv" Content="从自动校准CSV计算" Width="140" Margin="0,0,10,0" Click="BtnCalibFromAutoCsv_Click"/>
                                    <Button x:Name="btnCalibExport" Content="导出 CSV" Width="90" Margin="0,0,10,0" Click="BtnCalibExport_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnCalibDefaultCup" Content="应用默认(当前法桶)" Width="140" Margin="0,0,10,0" Click="BtnCalibDefaultCup_Click"/>
                                    <Button x:Name="btnCalibDefaultAll" Content="应用默认(全部)" Width="120" Margin="0,0,10,0" Click="BtnCalibDefaultAll_Click"/>
                                    <Button x:Name="btnCalibDownload" Content="下发到设备" Width="100" Click="BtnCalibDownload_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="默认法桶:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="comboCalibDefaultCup" Width="100" VerticalAlignment="Center">
                                        <ComboBoxItem Content="法桶 1" IsSelected="True"/>
                                        <ComboBoxItem Content="法桶 2"/>
                                        <ComboBoxItem Content="法桶 3"/>
                                        <ComboBoxItem Content="法桶 4"/>
                                        <ComboBoxItem Content="法桶 5"/>
                                        <ComboBoxItem Content="法桶 6"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="状态: " VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblCalibStatus" Text="就绪" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="来源: " VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblCalibSource" Text="---" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="记录数: " VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblCalibCount" Text="0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="校准系数表">
                            <DataGrid x:Name="gridCalibCoeff" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Height="240" Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="法桶" Binding="{Binding Cup}" Width="50"/>
                                    <DataGridTextColumn Header="量程" Binding="{Binding RangeName}" Width="70"/>
                                    <DataGridTextColumn Header="系数1(c3)" Binding="{Binding C3, StringFormat={}{0:R}}" Width="100"/>
                                    <DataGridTextColumn Header="系数2(c2)" Binding="{Binding C2, StringFormat={}{0:R}}" Width="100"/>
                                    <DataGridTextColumn Header="系数3(c1)" Binding="{Binding C1, StringFormat={}{0:R}}" Width="100"/>
                                    <DataGridTextColumn Header="系数4(c0)" Binding="{Binding C0, StringFormat={}{0:R}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
